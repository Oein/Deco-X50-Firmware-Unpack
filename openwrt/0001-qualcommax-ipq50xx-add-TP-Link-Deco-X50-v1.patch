diff --git a/target/linux/qualcommax/dts/ipq5018-deco-x50-v1.dts b/target/linux/qualcommax/dts/ipq5018-deco-x50-v1.dts
new file mode 100644
index 0000000..ae01f8f
--- /dev/null
+++ b/target/linux/qualcommax/dts/ipq5018-deco-x50-v1.dts
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "ipq5018.dtsi"
+#include "ipq5018-ess.dtsi"
+#include "ipq5018-qcn6122.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+/*
+ * Hardware description is taken from the TP-Link GPL release that the
+ * Deco X50 v1 support page links to (GPL_X55.tar.gz), board file
+ * qcom-ipq5018-mp03.3.dts (IPQ5018 + QCN6102 5 GHz + RTL8367S), and from
+ * the boot log / flash dump in this repository's README.
+ *
+ * Items marked UNVERIFIED have not been confirmed on real hardware yet.
+ */
+
+/ {
+	model = "TP-Link Deco X50 v1";
+	compatible = "tplink,deco-x50-v1", "qcom,ipq5018";
+
+	aliases {
+		serial0 = &blsp1_uart1;
+		led-boot = &led_status_green;
+		led-failsafe = &led_status_red;
+		led-running = &led_status_green;
+		led-upgrade = &led_status_blue;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M";
+	};
+
+	keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&button_pins>;
+		pinctrl-names = "default";
+
+		button-reset {
+			label = "reset";
+			gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+	};
+
+	/* single RGB status LED on top of the unit */
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-0 = <&led_pins>;
+		pinctrl-names = "default";
+
+		led_status_red: led-0 {
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
+		};
+
+		led_status_green: led-1 {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
+		};
+
+		led_status_blue: led-2 {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_STATUS;
+			gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
+		};
+	};
+
+	/*
+	 * realtek,extif: cpu port 6 (extif0), no RGMII delays, HSGMII,
+	 * forced 2.5G full duplex link with pause frames.
+	 */
+	switch {
+		compatible = "realtek,rtl8367b";
+		realtek,extif = <6 0 0 18 1 1 1 1 1 5>;
+		realtek,skip-initvals;
+		mii-bus = <&mdio1>;
+		phy-id = <29>;
+	};
+};
+
+&sleep_clk {
+	clock-frequency = <32000>;
+};
+
+&xo_board_clk {
+	clock-div = <4>;
+	clock-mult = <1>;
+};
+
+&blsp1_uart1 {
+	pinctrl-0 = <&serial_0_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&prng {
+	status = "okay";
+};
+
+&qfprom {
+	status = "okay";
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+/* ESMT F50D1G41LB, 128 MiB SPI-NAND; layout from the stock boot log */
+&qpic_nand {
+	pinctrl-0 = <&qpic_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+
+		nand-ecc-engine = <&qpic_nand>;
+		nand-ecc-strength = <4>;
+		nand-ecc-step-size = <512>;
+		nand-bus-width = <8>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "0:SBL1";
+				reg = <0x0 0x80000>;
+				read-only;
+			};
+
+			partition@80000 {
+				label = "0:MIBIB";
+				reg = <0x80000 0x80000>;
+				read-only;
+			};
+
+			partition@100000 {
+				label = "0:BOOTCONFIG";
+				reg = <0x100000 0x40000>;
+				read-only;
+			};
+
+			partition@140000 {
+				label = "0:BOOTCONFIG1";
+				reg = <0x140000 0x40000>;
+				read-only;
+			};
+
+			partition@180000 {
+				label = "0:QSEE";
+				reg = <0x180000 0x100000>;
+				read-only;
+			};
+
+			partition@280000 {
+				label = "0:DEVCFG";
+				reg = <0x280000 0x40000>;
+				read-only;
+			};
+
+			partition@2c0000 {
+				label = "0:CDT";
+				reg = <0x2c0000 0x40000>;
+				read-only;
+			};
+
+			partition@300000 {
+				label = "0:APPSBLENV";
+				reg = <0x300000 0x80000>;
+			};
+
+			partition@380000 {
+				label = "0:APPSBL";
+				reg = <0x380000 0x140000>;
+				read-only;
+			};
+
+			partition@4c0000 {
+				label = "0:ART";
+				reg = <0x4c0000 0x100000>;
+				read-only;
+			};
+
+			partition@5c0000 {
+				label = "0:TRAINING";
+				reg = <0x5c0000 0x80000>;
+				read-only;
+			};
+
+			partition@640000 {
+				label = "rootfs";
+				reg = <0x640000 0x2a00000>;
+			};
+
+			partition@3040000 {
+				label = "rootfs_1";
+				reg = <0x3040000 0x2a00000>;
+			};
+
+			partition@5a40000 {
+				label = "0:ETHPHYFW";
+				reg = <0x5a40000 0x80000>;
+				read-only;
+			};
+
+			partition@5ac0000 {
+				label = "factory_data";
+				reg = <0x5ac0000 0x900000>;
+				read-only;
+			};
+
+			partition@63c0000 {
+				label = "runtime_data";
+				reg = <0x63c0000 0x1100000>;
+				read-only;
+			};
+		};
+	};
+};
+
+/*
+ * ===========================================================================
+ * Ethernet:
+ *
+ *   gmac1 -> uniphy0 -> 2.5G HSGMII (forced) -> RTL8367S-VB port 6 (extif0)
+ *   All three RJ45 jacks are RTL8367S-VB UTP ports: top = port 2,
+ *   middle = port 1, bottom = port 0 (used as WAN). The IPQ5018 internal
+ *   GE PHY (gmac0) is not wired to a jack, so gmac0 stays disabled.
+ *
+ * The switch is an RTL8367S-VB (chip id 0x6642, Realtek "family D") at
+ * mdio1 address 29, driven by the swconfig rtl8367b driver. Its reset line
+ * is GPIO39, which the stock U-Boot already releases.
+ * ===========================================================================
+ */
+
+/*
+ * mdio0 must stay enabled even though the GE PHY behind it is unused:
+ * registering the GE PHY deasserts GCC_GEPHY_MISC_ARES, which also gates
+ * the MDC/MDIO path shared with mdio1 (see the Archer AX55 v1).
+ */
+&mdio0 {
+	status = "okay";
+};
+
+&uniphy0 {
+	status = "okay";
+
+	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
+	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
+};
+
+&gmac1 {
+	status = "okay";
+
+	phy-mode = "2500base-x";
+
+	fixed-link {
+		speed = <2500>;
+		full-duplex;
+	};
+};
+
+&mdio1 {
+	status = "okay";
+
+	pinctrl-0 = <&mdio1_pins>;
+	pinctrl-names = "default";
+};
+
+/*
+ * WiFi: IPQ5018 2.4 GHz + QCN6102 5 GHz (AX3000), same arrangement as the
+ * Archer AX55 v1 / GL-B3000. Pre-cal comes from 0:ART via the
+ * 11-ath11k-caldata hotplug (same offsets as the stock
+ * /lib/read_caldata_to_fs.sh). Board data comes from the stock
+ * bdwlan_<country>.b24 / .b60 files, see openwrt/make-board2.py.
+ */
+&q6v5_wcss {
+	status = "okay";
+};
+
+&wifi {
+	status = "okay";
+
+	qcom,rproc = <&q6_wcss_pd1>;
+	qcom,ath11k-fw-memory-mode = <1>;
+	qcom,ath11k-calibration-variant = "TP-Link-Deco-X50-v1";
+	qcom,bdf-addr = <0x4c400000>;
+};
+
+&wifi1 {
+	status = "okay";
+
+	qcom,rproc = <&q6_wcss_pd3>;
+	qcom,userpd-subsys-name = "q6v5_wcss_userpd3";
+	qcom,ath11k-fw-memory-mode = <1>;
+	qcom,ath11k-calibration-variant = "TP-Link-Deco-X50-v1";
+	qcom,bdf-addr = <0x4d100000>;
+	qcom,m3-dump-addr = <0x4df00000>;
+};
+
+&tlmm {
+	button_pins: button-state {
+		pins = "gpio33";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	led_pins: led-state {
+		pins = "gpio23", "gpio24", "gpio29";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	mdio1_pins: mdio1-state {
+		mdc-pins {
+			pins = "gpio36";
+			function = "mdc";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+
+		mdio-pins {
+			pins = "gpio37";
+			function = "mdio";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+
+	qpic_pins: qpic-state {
+		clock-pins {
+			pins = "gpio9";
+			function = "qspi_clk";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		cs-pins {
+			pins = "gpio8";
+			function = "qspi_cs";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data-pins {
+			pins = "gpio4", "gpio5", "gpio6", "gpio7";
+			function = "qspi_data";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
+
+	serial_0_pins: uart0-state {
+		pins = "gpio20", "gpio21";
+		function = "blsp0_uart0";
+		bias-disable;
+	};
+};
