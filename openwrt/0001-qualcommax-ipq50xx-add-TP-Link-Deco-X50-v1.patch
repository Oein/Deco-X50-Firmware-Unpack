+/* RTL8367S-VB: route SerDes 0 to MAC6 (extif0) and run it as HSGMII */
+static int rtl8367d_extif_set_hsgmii(struct rtl8366_smi *smi)
+{
+	int err;
+	u32 data;
+	int i;
+
+	REG_RMW(smi, RTL8367D_REG_BYPASS_LINE_RATE, BIT(1), 0);
+	REG_RMW(smi, RTL8367D_REG_SDS_MISC, RTL8367D_MAC6_SEL_SDS0,
+		RTL8367D_MAC6_SEL_SDS0);
+
+	for (i = 0; i < ARRAY_SIZE(rtl8367d_sds_nctrl_patch); i++)
+		REG_WR(smi, rtl8367d_sds_nctrl_patch[i][0],
+		       rtl8367d_sds_nctrl_patch[i][1]);
+
+	for (i = 0; i < ARRAY_SIZE(rtl8367d_hsgmii_cfg); i++) {
+		REG_WR(smi, RTL8367D_REG_SDS_INDACS_DATA, rtl8367d_hsgmii_cfg[i][1]);
+		REG_WR(smi, RTL8367D_REG_SDS_INDACS_ADR, rtl8367d_hsgmii_cfg[i][0]);
+		REG_WR(smi, RTL8367D_REG_SDS_INDACS_CMD, 0x00cd);
+	}
+
+	REG_RMW(smi, RTL8367D_REG_FIBER_CFG_2, RTL8367D_SDS_RX_DISABLE_MASK, 0x0040);
+	REG_RMW(smi, RTL8367D_REG_SDS_MISC,
+		RTL8367D_PA12PC_EN_S0 | RTL8367D_PA33PC_EN_S0,
+		RTL8367D_PA12PC_EN_S0 | RTL8367D_PA33PC_EN_S0);
+	REG_RMW(smi, RTL8367D_REG_SDS_MISC, RTL8367D_SDS_MODE_MASK,
+		RTL8367D_PORT_SDS_MODE_HSGMII);
+
+	/*
+	 * The link is forced on both sides, so turn off in-band
+	 * autonegotiation in SerDes 0 register 2 (0x612f must be clear
+	 * while doing so).
+	 */
+	REG_WR(smi, RTL8367D_REG_SDS_INDACS_ADR, 0x0002);
+	REG_WR(smi, RTL8367D_REG_SDS_INDACS_CMD, 0x008d);
+	REG_RD(smi, RTL8367D_REG_SDS_INDACS_DATA, &data);
+	data = (data & ~0x0200) | 0x0100;
+	REG_WR(smi, RTL8367D_REG_SDS_INDACS_DATA, data);
+	REG_WR(smi, RTL8367D_REG_SDS_INDACS_ADR, 0x0002);
+	REG_WR(smi, RTL8367D_REG_SDS_INDACS_CMD, 0x00cd);
+
+	REG_WR(smi, 0x612f, 0x000c);
+
+	return 0;
+}
